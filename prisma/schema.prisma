generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
}

model Facility {
  id             String   @id @default(uuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())
}

model EmissionFactor {
  id          String @id @default(uuid())
  category    String
  fuelType    String?
  factorValue Float
  unit        String
  year        Int
}
